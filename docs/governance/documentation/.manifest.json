  "protocol_history": [
    {
      "version": "0.0.3",
      "date": "2026-03-31",
      "status": "current",
      "summary": "Protocol v0.0.3: Distributes pre-decision RFC governance architecture standard (RFC-0002), aligns core system invariant headers, and locks protocol assets."
    },
    {
      "version": "0.0.2",
      "date": "2026-10-05",
      "status": "superseded",
      "summary": "Protocol v0.0.2: Distributes the canonical .docgov.yml adoption template (spec/default-config.yml) as a first-class, manifest-registered spec asset, enabling `docgov init` to materialize configuration directly from the sovereign specification rather than hard-coding it in the engine."
    },
    {
      "version": "0.0.1",
      "date": "2026-10-02",
      "status": "superseded",
      "summary": "Protocol v0.0.1 Initial Release: Zero-Vendoring Architecture, Flat Knowledge Topology, in-place Frontmatter lifecycle, and bifurcated invariants (INV-LINT machine layer and INV-AGENT cognitive layer)."
    }
  ],
